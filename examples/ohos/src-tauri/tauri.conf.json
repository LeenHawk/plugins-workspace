{
  "productName": "Tauri OHOS Plugins",
  "version": "0.1.0",
  "identifier": "dev.tauri.ohosplugins",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OHOS plugins"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/host-probe-range.bin"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../api/src-tauri/icons/icon.png"
    ]
  }
}
